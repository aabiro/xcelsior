{
  "name": "@xcelsior-gpu/mcp-server",
  "version": "2.0.0",
  "description": "Hosted Model Context Protocol server for Xcelsior GPU platform",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:api": "openapi-typescript openapi-v1.json -o src/client/generated/api.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- openapi-v1.json src/client/generated/api.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "openapi-fetch": "^0.17.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^4.7.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.8",
    "js-yaml": "4.3.0"
  }
}
