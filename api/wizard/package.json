{
  "name": "@xcelsior-gpu/wizard",
  "version": "0.1.9",
  "description": "Xcelsior interactive CLI wizard — Ink-based setup & onboarding",
  "homepage": "https://docs.xcelsior.ca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aabiro/xcelsior.git",
    "directory": "api/wizard"
  },
  "bugs": {
    "url": "https://github.com/aabiro/xcelsior/issues"
  },
  "keywords": ["xcelsior", "gpu", "compute", "cli", "onboarding", "ink"],
  "license": "BUSL-1.1",
  "type": "module",
  "bin": {
    "xcelsior-wizard": "dist/src/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate-frames": "tsx scripts/generate-wizard-frames.ts",
    "prebuild": "npm run generate-frames",
    "build": "tsc",
    "postbuild": "node scripts/package-worker-installer.mjs",
    "test:sdk:contract": "tsx scripts/sdk-contract-smoke.ts",
    "dev": "tsx src/index.tsx",
    "demo": "tsx src/animation-demo.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
