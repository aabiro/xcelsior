{
  "name": "@xcelsior-gpu/mcp-server",
  "version": "2.0.0",
  "description": "Hosted Model Context Protocol server for Xcelsior GPU platform",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.20.0 || >=22.22.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "surface:update": "tsx scripts/update-tool-surface.ts",
    "generate:api": "openapi-typescript openapi-v1.json -o src/client/generated/api.d.ts",
    "check:api": "npm run generate:api && git diff --exit-code -- openapi-v1.json src/client/generated/api.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@posthog/mcp": "0.11.4",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "openapi-fetch": "^0.17.0",
    "pino": "^10.3.1",
    "posthog-node": "5.48.1",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^4.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@hono/node-server": "2.1.7",
    "body-parser": "2.4.0",
    "brace-expansion": "5.0.12",
    "fast-uri": "4.2.3",
    "hono": "4.13.18",
    "ip-address": "10.7.6",
    "js-yaml": "4.3.2",
    "minimatch": "11.0.8",
    "nanoid": "3.3.18",
    "postcss": "8.5.28",
    "qs": "6.17.1",
    "source-map-js": "1.2.2"
  }
}
