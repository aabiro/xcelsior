    {
      "id": 9,
      "type": "table",
      "title": "Retirement expectation by path and API replica",
      "description": "0 means the current policy still permits callers; 1 declares an expectation of zero callers. This policy does not disable handlers. Canary does not automatically retire these paths.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "xcelsior_legacy_path_retired{job=\"xcelsior-api\"}",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{path}} \u00b7 {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Retirement expectation"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "Callers permitted",
                        "color": "orange"
                      },
                      "1": {
                        "text": "Zero callers expected",
                        "color": "blue"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "seriesToRows",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "replica": true
            },
            "indexByName": {
              "path": 0,
              "instance": 1,
              "Value": 2,
              "Metric": 3
            },
            "renameByName": {
              "path": "Legacy path",
              "instance": "API replica",
              "Metric": "Path \u00b7 API replica",
              "Value": "Retirement expectation"
            }
          }
        }
      ]
    },
