{
  "id": null,
  "uid": "xcelsior-legacy-retirement",
  "title": "Xcelsior Legacy Retirement",
  "description": "Per-replica collection checks and eight API compatibility paths. Missing observations are never substituted with zero. This dashboard does not certify a retirement window.",
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "xcelsior",
    "legacy-retirement"
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Read the collection checks before interpreting zero use",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "These panels cover eight authenticated API compatibility paths. **A zero is evidence only while every expected API replica is scraped, aggregation is enabled, and all expected series are present.** Missing data, gaps, counter resets or a new master generation invalidate a retirement window. Confirm the active replica inventory against the release record. The agreed zero-use window and other B16 paths still require separate evidence."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API scrape up",
      "description": "1 means this target was scraped successfully. A missing target is NO DATA; verify the expected replica inventory.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"xcelsior-api\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "NO DATA",
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
