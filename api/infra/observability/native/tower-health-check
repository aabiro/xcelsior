#!/bin/bash
# Export current-boot kernel failures and stored RAS hardware-error records.
set -eu  # grep may exit 1 when there are no kernel failures.
OUT=${TOWER_HEALTH_OUTPUT:-/var/lib/prometheus/node-exporter/tower_health.prom}
TMP=$(mktemp "${OUT}.XXXX")
trap 'rm -f "$TMP"' EXIT

kernel=$(journalctl -k -b --no-pager -o cat 2>/dev/null \
  | grep -i -E "mce|hardware error|oops|bug:|soft lockup|hard lockup|rcu.*stall|EXT4-fs error|I/O error" \
  | grep -v -i -E "In-kernel MCE decoding enabled|NMI watchdog: Enabled" | wc -l)

# rasdaemon also stores process signals (SIGCHLD, SIGTERM, etc.). Those are
# numbered just like hardware records, but do not establish hardware failure.
# Read successfully before parsing: a failed RAS query must not publish zero.
ras_records=$(ras-mc-ctl --errors)
ras=$(printf '%s\n' "$ras_records" | awk '
  /^[[:alpha:]][^:]*:[[:space:]]*$/ { signals = ($0 ~ /^SIGNAL events:/) }
  !signals && /^[0-9]+ / { count++ }
  END { print count + 0 }
')

cat > "$TMP" <<EOF
# HELP tower_health_kernel_errors_boot Kernel log lines this boot matching hardware/kernel failure patterns.
# TYPE tower_health_kernel_errors_boot gauge
tower_health_kernel_errors_boot ${kernel}
# HELP tower_health_ras_errors_total Hardware error records stored by rasdaemon, excluding process signals.
# TYPE tower_health_ras_errors_total gauge
tower_health_ras_errors_total ${ras}
# HELP tower_health_last_run_timestamp_seconds When tower-health-check last ran.
# TYPE tower_health_last_run_timestamp_seconds gauge
tower_health_last_run_timestamp_seconds $(date +%s)
EOF
chmod 644 "$TMP"
mv "$TMP" "$OUT"
