[Unit]
Description=Xcelsior PostgreSQL verified backup
Documentation=file:/opt/xcelsior/api/docs/xcelsior-production-data-architecture-companion.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/xcelsior
EnvironmentFile=-/etc/xcelsior/db-maintenance.env
ExecStart=/opt/xcelsior/api/scripts/with-runtime-secrets.sh /opt/xcelsior/api/scripts/backup-db.sh
ExecStopPost=/usr/bin/python3 /opt/xcelsior/api/scripts/db_maintenance_failure.py backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/xcelsior /var/lib/node_exporter/textfile_collector
NoNewPrivileges=true
