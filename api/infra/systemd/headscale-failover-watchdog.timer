[Unit]
Description=Check Headscale health and promote a replica if the VPS stays down

[Timer]
# OnActiveSec makes a stop/start (the pause around a VPS reboot) schedule a run.
# Without it, OnBootSec has passed and OnUnitActiveSec has no reference until the
# service runs again, so the timer shows NEXT "-" and never fires. Persistent=
# applies only to OnCalendar.
OnBootSec=1min
OnActiveSec=1min
OnUnitActiveSec=2min
Persistent=true
Unit=headscale-failover-watchdog.service

[Install]
WantedBy=timers.target
