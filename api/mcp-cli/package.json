{
  "name": "@xcelsior-gpu/mcp",
  "version": "0.1.0",
  "description": "Stdio MCP client for the Xcelsior GPU platform — use with npx @xcelsior-gpu/mcp",
  "type": "module",
  "bin": {
    "xcelsior-mcp": "bin/xcelsior-mcp.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/api": "^1.9.1",
    "@posthog/mcp": "0.11.4",
    "openapi-fetch": "^0.17.0",
    "posthog-node": "5.48.1",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "zod": "^3.24.0"
  },
  "keywords": [
    "mcp",
    "gpu",
    "xcelsior",
    "model-context-protocol",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aabiro/xcelsior.git",
    "directory": "mcp-cli"
  }
