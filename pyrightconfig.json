{
  "include": ["."],
  "extraPaths": [
    "archive",
    "billing",
    "workers",
    "auth",
    "hosts",
    "privacy",
    "api",
    "core"
  ],
  "exclude": [
    "venv",
    "node_modules",
    "frontend",
    "api/frontend",
    "**/__pycache__",
    "tests",
    "migrations",
    "api/migrations",
    "desktop",
    "api/desktop",
    "wizard",
    "archive/wizard",
    "fern",
    "api/fern",
    "sprites",
    "api/sprites",
    "checkpoints",
    "workers/checkpoints",
    "artifacts",
    "archive/artifacts",
    "data",
    "core/data",
    "scripts",
    "api/scripts",
    "**/.*"
  ],
  "typeCheckingMode": "off",
  "reportCallIssue": "error",
  "reportArgumentType": "error",
  "reportAttributeAccessIssue": "error",
  "reportOptionalMemberAccess": "error",
  "reportOptionalSubscript": "error",
  "reportMissingImports": false,
  "reportMissingModuleSource": false
}
