# Agent gateway shared secret — TEMPLATE. Do not commit the real value.
#
# This must equal XCELSIOR_AGENT_GATEWAY_SECRET in the API's environment. The
# gateway sets X-Xcelsior-Gateway-Auth to this value on every proxied worker
# request; control_plane.identity.gateway_headers_authenticated compares it
# with hmac.compare_digest. A public client cannot forge the header because it
# does not know the secret.
#
# If the two sides disagree, every gateway-authenticated agent request is
# rejected with 401 "Agent gateway authentication failed". If the API side is
# empty while XCELSIOR_TRUSTED_AGENT_GATEWAY=1, startup validation fails the
# deploy — identity headers would otherwise be forgeable.
#
# Generate the real file from the API environment (never by hand):
#
#     sudo ./scripts/write-agent-gateway-secret.sh
#
# which writes /etc/nginx/snippets/agent-gateway-secret.conf with mode 0640,
# owned by root:www-data, then reload nginx.

set $xcelsior_agent_gateway_secret "REPLACE_WITH_XCELSIOR_AGENT_GATEWAY_SECRET";
