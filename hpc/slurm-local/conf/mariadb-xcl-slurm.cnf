# Installed as /etc/mysql/mariadb.conf.d/90-xcl-slurm.cnf before mariadb-server,
# so the server never opens a TCP port (the tower's mempool-db container
# already uses 3306 inside Docker). slurmdbd connects over the unix socket.
[mysqld]
skip-networking=1
# SchedMD requires this OFF: with it ON (MariaDB 11.6.2+ default; Ubuntu
# 26.04 ships 11.8), a concurrent write can make slurmdbd stop with an
# error it cannot recover from (slurm.schedmd.com/accounting.html).
innodb_snapshot_isolation=OFF
# SchedMD's guidance is at least 4 GiB; 512M is a deliberate deviation for a
# two-node test cluster on a shared machine.
innodb_buffer_pool_size=512M
innodb_log_file_size=64M
innodb_lock_wait_timeout=900
max_allowed_packet=16M
