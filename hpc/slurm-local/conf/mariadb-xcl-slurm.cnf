# Installed as /etc/mysql/mariadb.conf.d/90-xcl-slurm.cnf before mariadb-server,
# so the server never opens a TCP port (the tower's mempool-db container
# already uses 3306 inside Docker). slurmdbd connects over the unix socket.
[mysqld]
skip-networking=1
innodb_buffer_pool_size=128M
innodb_log_file_size=64M
innodb_lock_wait_timeout=900
max_allowed_packet=16M
