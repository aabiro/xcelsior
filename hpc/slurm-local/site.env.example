# Site-specific values for the xcl-local kit. Copy to site.env (git ignores
# it: the repository is public) and fill in. The scripts refuse to render a
# config while any of these is missing.
#
# The tower's tailnet address (controller + GPU node).
TOWER_ADDR=
# The asus's tailnet address (CPU node; the adapter runs here).
ASUS_ADDR=
# `hostname -s` on the asus (slurm.conf NodeHostname for node "asus").
ASUS_HOSTNAME=
# Your own login on both machines: unrestricted SSH between them and sudo.
# Never the account jobs run as (that is the xclslurm service account).
OPERATOR_USER=
#
# Memory each node offers Slurm, in MB (slurm.conf RealMemory). Optional;
# these are the defaults. Keep them well below the installed RAM so jobs
# can't crowd out what already runs there, and never above it: Slurm drains
# a node that has less than it declares. Preflight checks this.
TOWER_MEM_MB=8192
ASUS_MEM_MB=4096
