[Unit]
Description=Headscale control-plane failover watchdog
Documentation=file:/mnt/storage/projects/xcelsior/runbooks/headscale-failover.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/default/headscale-failover
ExecStart=/usr/local/sbin/headscale-failover watchdog --execute
PrivateTmp=true
NoNewPrivileges=true
