# Xcelsior Worker Agent — environment template
#
# Copy to `.env.worker` (gitignored) and fill in. The systemd unit points at
# `~/.xcelsior/worker.env`; this file is the documented shape of that one.
#
# **This file lists exactly the variables `worker_agent.py` reads.**
# `tests/test_worker_env_example_is_complete.py` derives that set from the
# source and fails if the two drift, so a new `os.environ.get` in the agent
# cannot ship without appearing here.
#
# What does NOT belong in a worker env file: control-plane configuration.
# Grafana admin credentials, Postgres exporter passwords, alertmanager paths
# and `XCELSIOR_AGENT_PUBLIC_INGRESS` are server-side. A worker env file is
# copied onto rented GPU machines you do not control; anything in it is
# disclosed to the host operator. Keep server config in `.env`.

# ── Identity ──────────────────────────────────────────────────────────
# The host id the control plane admitted. Must match a registered host or
# every heartbeat is rejected.
XCELSIOR_HOST_ID=
# Falls back to HOST_ID when unset. Prefer the prefixed name.
HOST_ID=
XCELSIOR_HOST_IP=

# ── Control plane ─────────────────────────────────────────────────────
# The private agent gateway is https://agent.xcelsior.ca. The public origin
# (https://xcelsior.ca) retired the worker protocol and answers 410
# `agent_ingress_retired`. Local staging is http://127.0.0.1:9600.
XCELSIOR_SCHEDULER_URL=

# ── Agent gateway client certificate (mTLS) ───────────────────────────
# Required when XCELSIOR_SCHEDULER_URL points at the gateway. It verifies a
# client certificate and derives this host's identity from the certificate's
# CN, which **must equal XCELSIOR_HOST_ID**.
#
# Without both of these the gateway answers 400 before the request reaches the
# API — a missing credential that looks like a network fault. Leave both empty
# for a worker still on a public/staging ingress; the agent then sends no
# client certificate, exactly as before.
#
# Issue by generating the key locally and having only a CSR signed by the fleet
# CA: the private key should never leave the host it identifies.
XCELSIOR_AGENT_CLIENT_CERT=
XCELSIOR_AGENT_CLIENT_KEY=

# Speak the `/agent/v2/*` spelling of the worker protocol.
#
# Blueprint §22.3: the agent gateway serves `/agent/v2/*` and 404s everything
# else, so a worker still calling `/host` has no heartbeat once Envoy replaces
# the interim Nginx gateway.
#
# Off by default on purpose. The v2 aliases must already be live on the API, and
# a worker that switches early loses its heartbeat with no way back except an
# operator editing this file on the host. The interim Nginx gateway proxies both
# spellings, so set this to 1 to verify against the running fleet *before* the
# cutover makes v2 the only option.
XCELSIOR_AGENT_V2_PATHS=

# Delete this host's registration when the agent shuts down. Leave EMPTY unless
# you are genuinely decommissioning the machine.
#
# Deleting a host cascades to `host_admission_decisions` and
# `host_admission_evidence`, so this discards the operator's signed admission and
# the evidence behind it. It used to run on every graceful shutdown, which meant
# a `systemctl restart` silently revoked the host's own admission: it came back
# `pending` and was refused all work with 403. That looked twice like a database
# losing writes before the cause was found.
#
# You do not need this to go offline cleanly. The scheduler marks an absent host
# dead after a grace period on its own.
XCELSIOR_WORKER_DEREGISTER_ON_EXIT=
XCELSIOR_API_URL=
XCELSIOR_REGISTRY_URL=
XCELSIOR_HEADSCALE_URL=
TOWER_SERVERLESS_URL=

# ── Authentication: a token, or OAuth ─────────────────────────────────
# OAuth is preferred over the static token when both are set.
XCELSIOR_API_TOKEN=
XCELSIOR_HOST_SECRET=
# Falls back to HOST_SECRET when unset.
HOST_SECRET=
XCELSIOR_OAUTH_CLIENT_ID=
XCELSIOR_OAUTH_CLIENT_SECRET=
XCELSIOR_OAUTH_SCOPE=
XCELSIOR_OAUTH_TOKEN_URL=
XCELSIOR_OAUTH_TOKEN_TIMEOUT_SEC=
XCELSIOR_OAUTH_TOKEN_REFRESH_SKEW_SEC=
# Path to a file holding the host token, read instead of the inline value.
XCELSIOR_AGENT_TOKEN_FILE=

# ── Private agent gateway ─────────────────────────────────────────────
# Set only while the mTLS cutover is unfinished. The API refuses worker
# paths with 410 when XCELSIOR_AGENT_PUBLIC_INGRESS=deny unless the request
# carries this secret. It is a bearer credential on public ingress, not
# gateway attestation — whoever holds it is effectively at `allow`. Per
# environment: staging's value is not prod's.
XCELSIOR_AGENT_GATEWAY_SECRET=

# ── What this host advertises ─────────────────────────────────────────
XCELSIOR_GPU_MODEL=
XCELSIOR_GPU_VRAM_GB=
XCELSIOR_COST_PER_HOUR=
XCELSIOR_REGION=
XCELSIOR_COUNTRY=
XCELSIOR_HOST_SSH_USER=

# ── Cadences and limits (seconds unless noted) ────────────────────────
XCELSIOR_HEARTBEAT_INTERVAL=
XCELSIOR_POLL_INTERVAL=
XCELSIOR_TELEMETRY_INTERVAL=
XCELSIOR_OBSERVATION_INTERVAL=
XCELSIOR_MINING_CHECK_INTERVAL=
XCELSIOR_CONTAINER_START_TIMEOUT=
XCELSIOR_PREEMPTION_GRACE_SEC=
# Consecutive heartbeat failures before the agent shuts down. systemd then
# restarts it, so a wedged control plane shows up as a restart cadence.
XCELSIOR_MAX_FAILURES=

# ── Images ────────────────────────────────────────────────────────────
XCELSIOR_IMAGE_WARMER_ENABLED=
XCELSIOR_IMAGE_PREPULL_ENABLED=
XCELSIOR_IMAGE_PREPULL_INTERVAL=
XCELSIOR_COSIGN_PUBLIC_KEY=

# ── Network ───────────────────────────────────────────────────────────
XCELSIOR_TAILSCALE_ENABLED=
XCELSIOR_TAILSCALE_SOCKET=
XCELSIOR_TAILSCALE_AUTHKEY=

# ── NFS (volumes exported by the control-plane host) ──────────────────
XCELSIOR_NFS_SERVER=
XCELSIOR_NFS_EXPORT_BASE=
XCELSIOR_NFS_PATH=
XCELSIOR_NFS_MOUNT=
# Mount options for the export above. Read by `worker_nfs.py`.
XCELSIOR_NFS_MOUNT_OPTS=

# ── Image cache (read by `worker_image_cache.py`) ──────────────────────
# How large the local image cache may grow, and the free-space floor that
# triggers eviction. An operator sizing a host's disk sets exactly these; left
# unset the agent picks a default nobody chose and reports healthy.
XCELSIOR_IMAGE_CACHE_MAX_GB=
XCELSIOR_IMAGE_CACHE_EVICT_LOW_GB=

# ── NVMe scratch cache (read by `worker_nvme_cache.py`) ────────────────
XCELSIOR_NVME_CACHE_DIR=
XCELSIOR_NVME_CACHE_MAX_GB=

# ── Encrypted volumes (read by `worker_luks_volumes.py`) ───────────────
# Where LUKS volumes are mounted, and where their keys live. The key directory
# holds material that unlocks a tenant's data — it must not sit on the same
# disk the volume does, and it must not be world-readable.
XCELSIOR_VOLUME_DIR=
XCELSIOR_VOLUME_KEY_DIR=

# ── Runtime ───────────────────────────────────────────────────────────
XCELSIOR_PREFER_GVISOR=
XCELSIOR_TOOLS_DIR=
WORKER_AGENT_AUTO_REINJECT=
# Where the v2 attempt journal is written. A start_attempt owns its own
# claim/ACK/dead-letter lifecycle and this is where that state survives a
# restart, so pointing it at a tmpfs loses in-flight attempts on reboot.
XCELSIOR_V2_JOURNAL_PATH=
# Development only. Permits an unverified agent upgrade; never set in prod.
XCELSIOR_ALLOW_INSECURE_UPGRADE=
